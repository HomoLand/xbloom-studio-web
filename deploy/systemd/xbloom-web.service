[Unit]
Description=xBloom Studio Web
Wants=xbloom-bridge.service network-online.target
After=xbloom-bridge.service network-online.target

[Service]
Type=exec
User=xbloom
Group=xbloom
WorkingDirectory=/opt/xbloom-studio/current/backend
EnvironmentFile=/etc/xbloom-studio/environment
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XBLOOM_BRIDGE_MANAGED=1
ExecStart=/opt/xbloom-studio/venv/bin/python -m serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xbloom-studio

[Install]
WantedBy=multi-user.target
