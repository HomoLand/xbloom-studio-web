[Unit]
Description=xBloom Studio BLE bridge
After=bluetooth.service

[Service]
Type=exec
User=xbloom
Group=xbloom
WorkingDirectory=/opt/xbloom-studio/current
EnvironmentFile=/etc/xbloom-studio/environment
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/xbloom-studio/venv/bin/python -m xbloom_ble.bridge serve
ExecStop=/opt/xbloom-studio/venv/bin/python -m xbloom_ble.bridge stop --force
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xbloom-studio

[Install]
WantedBy=multi-user.target
